# Database
DATABASE_URL="postgresql://user:password@localhost:5432/chatbot"
MONGODB_URI="mongodb://localhost:27017/chatbot"
DATABASE_PROVIDER="supabase" # or "mongodb"

# Supabase (if using Supabase)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_service_role_key"

# AI APIs
ANTHROPIC_API_KEY="sk-ant-..." # Your Anthropic API key
GEMINI_API_KEY="AIza..." # Your Google Gemini API key

# Authentication
NEXTAUTH_SECRET="your-secret-key-here-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# JWT
JWT_SECRET="your-jwt-secret-key"
JWT_EXPIRES_IN="7d"

# File Upload
MAX_FILE_SIZE="10485760" # 10MB in bytes
ALLOWED_MIME_TYPES="image/jpeg,image/png,image/gif,image/webp,video/mp4,video/webm,audio/mpeg,audio/wav,text/plain,application/pdf"

# API
NEXT_PUBLIC_API_URL="http://localhost:3000/api"

# Feature Flags
ENABLE_VOICE_INPUT="true"
ENABLE_FILE_UPLOAD="true"
ENABLE_IMAGE_ANALYSIS="true"
